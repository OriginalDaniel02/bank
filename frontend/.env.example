# Leave empty in development: Vite proxies /api to the backend (BACKEND_URL, default http://localhost:8080).
# Set it only to call a deployed API directly, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=

# Minutes of inactivity before the app signs you out (default 10).
# VITE_IDLE_MINUTES=10
